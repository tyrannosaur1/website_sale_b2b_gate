<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_b2b_gate" model="ir.ui.view">
        <field name="name">product.template.form.b2b.gate</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group name="b2b_gate" string="B2B Price Gate">
                    <field name="b2b_gate_policy"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_public_category_form_view_b2b_gate" model="ir.ui.view">
        <field name="name">product.public.category.form.b2b.gate</field>
        <field name="model">product.public.category</field>
        <field name="inherit_id" ref="website_sale.product_public_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="b2b_gate_policy"/>
            </xpath>
        </field>
    </record>

</odoo>
