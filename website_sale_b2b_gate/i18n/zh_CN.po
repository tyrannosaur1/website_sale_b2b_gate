#. module: website_sale_b2b_gate
#: model:mail.template,body_html:website_sale_b2b_gate.mail_template_quote_request
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#222\">\n"
"                <p>A quote request was sent from the website.</p>\n"
"                <table cellpadding=\"4\" cellspacing=\"0\" style=\"border-collapse:collapse\">\n"
"                    <tr>\n"
"                        <td style=\"font-weight:bold\">Reference</td>\n"
"                        <td><t t-out=\"object.name\"/></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"font-weight:bold\">Email</td>\n"
"                        <td><t t-out=\"object.email\"/></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"font-weight:bold\">Phone</td>\n"
"                        <td><t t-out=\"object.phone or ''\"/></td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p style=\"font-weight:bold;margin-bottom:4px\">Products</p>\n"
"                <ul style=\"margin-top:0\">\n"
"                    <t t-foreach=\"object.line_ids\" t-as=\"line\">\n"
"                        <li><t t-out=\"line.name\"/> x <t t-out=\"line.quantity\"/></li>\n"
"                    </t>\n"
"                </ul>\n"
"                <p style=\"font-weight:bold;margin-bottom:4px\">Message</p>\n"
"                <p style=\"white-space:pre-line\"><t t-out=\"object.message or ''\"/></p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#222\">\n"
"                <p>网站收到了一份报价请求。</p>\n"
"                <table cellpadding=\"4\" cellspacing=\"0\" style=\"border-collapse:collapse\">\n"
"                    <tr>\n"
"                        <td style=\"font-weight:bold\">参考</td>\n"
"                        <td><t t-out=\"object.name\"/></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"font-weight:bold\">电子邮件</td>\n"
"                        <td><t t-out=\"object.email\"/></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"font-weight:bold\">电话</td>\n"
"                        <td><t t-out=\"object.phone or ''\"/></td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p style=\"font-weight:bold;margin-bottom:4px\">产品</p>\n"
"                <ul style=\"margin-top:0\">\n"
"                    <t t-foreach=\"object.line_ids\" t-as=\"line\">\n"
"                        <li><t t-out=\"line.name\"/> x <t t-out=\"line.quantity\"/></li>\n"
"                    </t>\n"
"                </ul>\n"
"                <p style=\"font-weight:bold;margin-bottom:4px\">消息</p>\n"
"                <p style=\"white-space:pre-line\"><t t-out=\"object.message or ''\"/></p>\n"
"            </div>\n"
"        "

